{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario",
  "description": "EN: Community-created scenario pack.\nZH: 社区创作的剧本包。",
  "type": "object",
  "required": ["scenario_id", "name"],
  "properties": {
    "scenario_id": {
      "type": "string",
      "description": "EN: Unique ID, use namespace prefix (author.name).\nZH: 唯一 ID，建议使用命名空间前缀。"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "author": {
      "type": "string",
      "default": ""
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "rules": {
      "type": "object",
      "default": {},
      "description": "EN: Custom rules overriding default gameplay.\nZH: 覆盖默认玩法的自定义规则。"
    },
    "events_script": {
      "type": "string",
      "default": "scenario_default",
      "description": "EN: Ren'Py label for scenario events.\nZH: 剧本事件的 Ren'Py 标签。"
    },
    "starting_conditions": {
      "type": "object",
      "default": {},
      "properties": {
        "gold": { "type": "integer" },
        "chapter": { "type": "integer" },
        "girls": { "type": "integer" }
      }
    },
    "victory_conditions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "gold_min": { "type": "integer" },
          "reputation_min": { "type": "integer" },
          "girls_min": { "type": "integer" },
          "chapter_min": { "type": "integer" },
          "custom_label": { "type": "string" }
        }
      }
    }
  }
}
