translate chinese_simplified courtyard_scene_end_954ecd3a:

    # sill "Have a good evening, Master. The girls will be waiting for your next visit."
    sill "祝您今晚愉快，主人。姑娘们会等着您下次再来。"

# game/custom/mods/Courtyard/courtyard_scene.rpy:165
translate chinese_simplified courtyard_scene_end_e16c1b37:

    # sill "Goodbye, Master."
    sill "再见，主人。"
