translate chinese_simplified c3_ending_4fa91394:

    # kuro "Nevertheless, he did cross them, and was able to take Zan by storm, undefended, when spring came."
    kuro "Nevertheless, he did cross them, and was able to take Zan by storm, undefended, when spring came."

