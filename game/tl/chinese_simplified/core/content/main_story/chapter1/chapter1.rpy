translate chinese_simplified c1_meet_kosmo_1fd73b88:

    # kosmo laughing "Bwahahahaha!" with vpunch
    kosmo laughing "哈哈哈哈！" with vpunch

# game/BKchapter1.rpy:309
translate chinese_simplified c1_meet_kosmo_f3fbba34:

    # kosmo "Come on, men, let's head back to the marble palace... I need a clean, relaxing bath..."
    kosmo "来吧,伙计们,我们回青玉宫去...我需要一个干净舒适的浴室..."

# game/BKchapter1.rpy:318
translate chinese_simplified c1_meet_kosmo_e173c1c3:

    # sill "Oh, I hate this guy..."
    sill "我真讨厌这个家伙..."

# game/BKchapter1.rpy:320
translate chinese_simplified c1_meet_kosmo_41ecb0a8:

    # you "Yeah. I'm afraid we haven't seen the last of him..."
    you "是啊。但恐怕这不是我们最后一次见面..."

# game/BKchapter1.rpy:340
translate chinese_simplified c1_ambush_4ccc267c:

    # "Sill was done with her work, so she decided to accompany you for a morning walk."
    "希露完成了手头上的工作,决定陪你一起去晨间散步。"

# game/BKchapter1.rpy:346
translate chinese_simplified c1_ambush_2e654fa0:

    # "You head out, making your way through the slums and towards the food market."
    "你一路向前,穿过贫民窟,朝着食品市场的方向前进。"

# game/BKchapter1.rpy:348
translate chinese_simplified c1_ambush_d54e9e1e:

    # "The streets are eerily quiet today. You barely meet a few passersby, all apparently in a hurry to be somewhere else."
    "今天街道上惊人地安静。你几乎见不到几个行人,就算有人也都快步远离你。"

# game/BKchapter1.rpy:350
translate chinese_simplified c1_ambush_6c943ad6:

    # sill sad "The atmosphere is strange today, Master, don't you think?"
    sill sad "师父，今天气氛有些奇怪，您不觉得吗？"

# game/BKchapter1.rpy:352
translate chinese_simplified c1_ambush_6510f7dc:

    # you "Yes... Why isn't there anyone in the street?"
    you "是啊...为什么街上没有人?"

# game/BKchapter1.rpy:354
translate chinese_simplified c1_ambush_2e45f792:

    # "You walk down the deserted streets in oppressive silence."
    "你在沉重的寂静中沿着空旷的街道前行。"

# game/BKchapter1.rpy:358
translate chinese_simplified c1_ambush_57f165c7:

    # "Suddenly, you hear muffled footsteps in all directions. Shadows emerge from nearby streets, blocking your path."
    "突然,你听到四面八方传来脚步声。一些黑衣人从附近的街道上浮现出来,挡住了你的去路。"

# game/BKchapter1.rpy:394
translate chinese_simplified c1_ambush_0e311df7:

    # sergeant "Halt!"
    sergeant "动手!"

# game/BKchapter1.rpy:396
translate chinese_simplified c1_ambush_2b5644ae:

    # "A stern, tough looking woman is standing in the middle of the street. She stares at you with cold eyes, detailing your features and equipment."
    "一个看起来严厉而强硬的女人站在街中央。她用冰冷的眼神打量着你的表情和穿着。"

# game/BKchapter1.rpy:398
translate chinese_simplified c1_ambush_62ddc60f:

    # sergeant "It's him."
    sergeant "就是他。"

# game/BKchapter1.rpy:400
translate chinese_simplified c1_ambush_e6df72cd:

    # "She turns to the men in the shadows."
    "她转向那些黑衣人。"

# game/BKchapter1.rpy:402
translate chinese_simplified c1_ambush_9310c2d3:

    # sergeant "Men, this is our mark. Deal with it quickly, and meet me at the rendezvous point."
    sergeant "伙计们,发现目标。快解决掉,然后在集合点碰头。"

# game/BKchapter1.rpy:404
translate chinese_simplified c1_ambush_c76dab1b:

    # sergeant "Oh, and take the girl alive."
    sergeant "哦,对了,那个女孩得留活口。"

# game/BKchapter1.rpy:408
translate chinese_simplified c1_ambush_143056f7:

    # sill "Take me? What?"
    sill "抓我?什么?"

# game/BKchapter1.rpy:446
translate chinese_simplified c1_ambush_2a20b021:

    # you "Sill, get behind me! It's an ambush!" with vpunch
    you "希尔，快躲到我身后！有埋伏！" with vpunch

# game/BKchapter1.rpy:448
translate chinese_simplified c1_ambush_c7ebd843:

    # "Half-a-dozen masked men are rushing towards you. Others are coming from the back. They are blocking all escape routes."
    "六个蒙面刺客向你冲来。其他人从后面赶来。他们完全堵死了你的撤退路线。"

# game/BKchapter1.rpy:454
translate chinese_simplified c1_ambush_591f5b26:

    # you "En garde!"
    you "来吧!"

# game/BKchapter1.rpy:456
translate chinese_simplified c1_ambush_e2a235d3:

    # "You meet the first assaulters head on, and parry their attacks in a flurry of blows."
    "第一波攻势袭来,你在一阵猛烈的攻击中化解了他们的攻击。"

# game/BKchapter1.rpy:462
translate chinese_simplified c1_ambush_97d7e30d:

    # you "Let's see how good you are!"
    you "让我看看你们有几斤几两!"

# game/BKchapter1.rpy:464
translate chinese_simplified c1_ambush_23aab3b8:

    # "You desperately defend yourself against the onslaught, painfully aware that the attackers at your back will reach you any second."
    "你拼死防守,背侧的袭击随时会到来。"

# game/BKchapter1.rpy:472
translate chinese_simplified c1_ambush_9f6ef3e3:

    # "Every counter-attack you make is met with a parry, however."
    "你的每次反击都被他们轻松化解。"

# game/BKchapter1.rpy:474
translate chinese_simplified c1_ambush_dd6df548:

    # you "These men are no small-time thugs... They have training... *sweat*"
    you "这些人可不是普通的小混混...他们训练有素...*流汗*"

# game/BKchapter1.rpy:481
translate chinese_simplified c1_ambush_e2972483:

    # you "Barrier of Oznos!!"
    you "奥兹诺斯屏障!!"

# game/BKchapter1.rpy:483
translate chinese_simplified c1_ambush_3fbcc058:

    # "You keep a protective amulet for emergencies. Clenching it, you cast a magic barrier around you and Sill."
    "你为紧急情况准备了一枚护身符。你紧握着它,在你和希露周围生成了一个球形魔法屏障。"

# game/BKchapter1.rpy:491
translate chinese_simplified c1_ambush_dccbc664:

    # "All around you, the attackers strike at the barrier repeatedly. It doesn't seem like it can slow them down for very long."
    "攻击从四处袭来,刺客不断冲击着屏障。这似乎无法阻挡他们太久。"

# game/BKchapter1.rpy:493
translate chinese_simplified c1_ambush_51673492:

    # you "Hnnnn... *sweat*"
    you "嗯呣...流汗*"

# game/BKchapter1.rpy:498
translate chinese_simplified c1_ambush_e0306a0a:

    # "The amulet glows red hot in your hand as it absorbs more furious blows from your assailants."
    "护符因承受猛烈打击而变得通红发烫。"

# game/BKchapter1.rpy:500
translate chinese_simplified c1_ambush_c7d45bed:

    # sill "Master! Look out!"
    sill "主人!当心!"

# game/BKchapter1.rpy:502
translate chinese_simplified c1_ambush_1cc2c0cd:

    # "On a nearby roof, an attacker is arming a crossbow. Your barrier is starting to yield, and you know it won't be enough to stop bolts from passing through."
    "在附近的屋顶上,一名刺客正在装填十字弩。你的屏障正在逐渐失效,你知道它无法阻挡箭矢。"

# game/BKchapter1.rpy:506
translate chinese_simplified c1_ambush_ce9e16a0:

    # you "Sill! Where is Drogon!"
    you "希露!巨龙在哪里!"

# game/BKchapter1.rpy:508
translate chinese_simplified c1_ambush_8033251a:

    # sill "At... At home, Master!"
    sill "在...在家里,主人!"

# game/BKchapter1.rpy:510
translate chinese_simplified c1_ambush_bf3bffc2:

    # you "Aarh! Follow me!"
    you "啊!跟紧我!"

# game/BKchapter1.rpy:512
translate chinese_simplified c1_ambush_c4e825ef:

    # "Spotting a pile of half-rotten crates, you start climbing over them quickly, going for the roof of a nearby house."
    "你注意到附近有一堆破旧的木箱,你开始快速攀爬,冲向房顶。"

# game/BKchapter1.rpy:514
translate chinese_simplified c1_ambush_8f951435:

    # mthug "Quick! He's escaping!"
    mthug "快!他要逃了!"

# game/BKchapter1.rpy:516
translate chinese_simplified c1_ambush_439eebb0:

    # "Desperate, you climb from crate to crate, almost reaching the top. Sill is following you the best she can."
    "绝望中,你从一个箱子爬到另一个箱子,就快到房顶了。希露正竭尽全力跟上你。"

# game/BKchapter1.rpy:518
translate chinese_simplified c1_ambush_a5f7b8d1:

    # "You pull yourself up to the roof, and turn around to lend her a hand."
    "你爬到屋顶,回过身来打算拉她一把。"

# game/BKchapter1.rpy:520
translate chinese_simplified c1_ambush_e6ceb7b1:

    # "However, as Sill reaches the last crate, you hear an ill-fated sound."
    "然而,就在希露踩到最后一个箱子时,你听到了令人绝望的声音。"

# game/BKchapter1.rpy:524
translate chinese_simplified c1_ambush_b379d3b7:

    # "The crates give in, crumbling from under her. Sill falls back down into the street." with vpunch
    "板条箱在她身下坍塌，希尔跌落到街上。" with vpunch

# game/BKchapter1.rpy:528
translate chinese_simplified c1_ambush_509710ea:

    # sill "Eeek!!!" with vpunch
    sill "啊！！！" with vpunch

# game/BKchapter1.rpy:530
translate chinese_simplified c1_ambush_c234d17d:

    # you "No!"
    you "不!"

# game/BKchapter1.rpy:532
translate chinese_simplified c1_ambush_97f2b94b:

    # "Sill gets back up, but she has her back to the wall as the attackers close in and surround her. You watch helplessly from your precarious hideout."
    "希露跌倒又站了起来,但她已经被刺客包围。你只能从高处无助地看着。"

# game/BKchapter1.rpy:536
translate chinese_simplified c1_ambush_b6e6c22b:

    # sill "Hiii!!!!"
    sill "啊啊啊!!"

# game/BKchapter1.rpy:538
translate chinese_simplified c1_ambush_5382e0b7:

    # you "This is it..."
    you "到此为止吗..."

# game/BKchapter1.rpy:546
translate chinese_simplified c1_ambush_1f1068a3:

    # maya "Hold on!!!" with vpunch
    maya "坚持，稍等！！！" with vpunch

# game/BKchapter1.rpy:558
translate chinese_simplified c1_ambush_d9c38b2d:

    # maya "What do you think you're doing here?"
    maya "你们在干什么?"

# game/BKchapter1.rpy:560
translate chinese_simplified c1_ambush_876eb379:

    # mthug "What?"
    mthug "什么?"

# game/BKchapter1.rpy:562
translate chinese_simplified c1_ambush_8296eeca:

    # maya "I'm talking to you, punk. What do you think you're doing?"
    maya "问的就是你,小子。你们在做什么?"

# game/BKchapter1.rpy:564
translate chinese_simplified c1_ambush_953ac320:

    # mthug "What the... Piss off, bitch! Or you'll be in trouble!"
    mthug "什...滚开,臭女人!别自讨苦吃!"

# game/BKchapter1.rpy:566
translate chinese_simplified c1_ambush_ee1b30d4:

    # maya "{b}'I'{/b} will be in trouble? We are the city guard, you moron!"
    maya "{b}自讨苦吃{/b}?我们是巡逻队,你这个白痴!"

# game/BKchapter1.rpy:568
translate chinese_simplified c1_ambush_7bc7a7c3:

    # mthug "Oh, really? And what are you gonna... Wait, did you say 'we'?"
    mthug "噢,是吗?你们打算怎么...等等,你说'我们'?"

# game/BKchapter1.rpy:570
translate chinese_simplified c1_ambush_7aacd16f:

    # maya "Roz!"
    maya "罗兹!"

# game/BKchapter1.rpy:583
translate chinese_simplified c1_ambush_c7a605f9:

    # "A huge warrior charges from a side street, coming from behind the girl."
    "一位身材高大的武士从一条小巷里冲了出来,从她背后出现。"

# game/BKchapter1.rpy:585
translate chinese_simplified c1_ambush_768a4ccd:

    # roz "Maya!"
    roz "玛雅!"

# game/BKchapter1.rpy:589
translate chinese_simplified c1_ambush_51a2a580:

    # maya "Right on time. Let's show these brutes who's boss."
    maya "来的正是时候。告诉他们这里谁说了算。"

# game/BKchapter1.rpy:591
translate chinese_simplified c1_ambush_d7b008f9:

    # roz "Of course!"
    roz "遵命!"

# game/BKchapter1.rpy:593
translate chinese_simplified c1_ambush_1001be5e:

    # roz "Hey! Come and face me! I'll gut you, maggots!" with vpunch
    roz "嘿！来啊，跟我对峙！我要把你们这些蛆虫开膛破肚！" with vpunch

# game/BKchapter1.rpy:595
translate chinese_simplified c1_ambush_1b4f617b:

    # mthug "It's... It's Roz!!! Run for your life!"
    mthug "那、那是罗兹!!!快逃啊!"

# game/BKchapter1.rpy:597
translate chinese_simplified c1_ambush_0f52ef92:

    # roz "BWAAAAAAAAAAAAAAH!!!!" with vpunch
    roz "哇啊 ..." with vpunch

# game/BKchapter1.rpy:599
translate chinese_simplified c1_ambush_cb65de9f:

    # "Your attackers break out and run. The giant warrior leaps after them, yelling taunts and insults."
    "刺客们逃散开来。那位高大的武士跟在他们后面追赶,大声嘲讽与辱骂。"

# game/BKchapter1.rpy:601
translate chinese_simplified c1_ambush_f86aa5c9:

    # roz "Turn around and fight! Come on! You guys are no fun..."
    roz "回来战斗!拜托!这也太没劲了..."

# game/BKchapter1.rpy:607
translate chinese_simplified c1_ambush_63597e88:

    # maya "Hey! Don't go too far, ok!"
    maya "嘿!别追太远,知道吗!"

# game/BKchapter1.rpy:609
translate chinese_simplified c1_ambush_bc06cfc0:

    # "She turns towards you."
    "她转向你。"

# game/BKchapter1.rpy:611
translate chinese_simplified c1_ambush_2a91468c:

    # maya "You guys all right?"
    maya "你们没事吧?"

# game/BKchapter1.rpy:615
translate chinese_simplified c1_ambush_f1e76649:

    # sill happy "Oh, thank you, Madam! You've saved us..."
    sill happy "哦，谢谢您，夫人！您救了我们……"

# game/BKchapter1.rpy:617
translate chinese_simplified c1_ambush_c1ac9f44:

    # you "I had it under control... But thanks for showing up."
    you "我自己能解决...不过还是谢谢你伸出援手。"

# game/BKchapter1.rpy:619
translate chinese_simplified c1_ambush_7368de48:

    # maya "Of course, citizen. The city guard is here to help."
    maya "当然,市民。巡逻队的职责所在。"

# game/BKchapter1.rpy:621
translate chinese_simplified c1_ambush_1258b1db:

    # you "Sure..."
    you "当然..."

# game/BKchapter1.rpy:623
translate chinese_simplified c1_ambush_d83ba17e:

    # "She frowns."
    "她皱眉。"

# game/BKchapter1.rpy:625
translate chinese_simplified c1_ambush_ccc71a2b:

    # maya "Hey! I know that look."
    maya "嘿!我知道你在想什么。"

# game/BKchapter1.rpy:627
translate chinese_simplified c1_ambush_57130f81:

    # maya "I hope you will tell your friends that not all guards are a bunch of drunkards and cheats."
    maya "我希望你能告诉你的朋友们,并不是所有的士兵都是酒鬼和骗子。"

# game/BKchapter1.rpy:629
translate chinese_simplified c1_ambush_f1ad0e4b:

    # maya "Anyway, do you have any idea what those thugs wanted from you?"
    maya "总之,你知道那些混混为什么要对付你吗?"

# game/BKchapter1.rpy:631
translate chinese_simplified c1_ambush_5d77664e:

    # you "No, they came out from nowhere... They had martial training. Those were not mere thieves..."
    you "不知道,他们突然从那里冒了出来...他们训练有素。不是普通的混混..."

# game/BKchapter1.rpy:633
translate chinese_simplified c1_ambush_1d3ba589:

    # sill "A woman was leading them, but we've never seen her before..."
    sill "有个女人带队,但我们从未见过她..."

# game/BKchapter1.rpy:635
translate chinese_simplified c1_ambush_5a85e245:

    # maya "Sounds like a contract killing. We have a lot of those, nowadays."
    maya "听起来像是有人雇了杀手。这种事时常发生。"

# game/BKchapter1.rpy:637
translate chinese_simplified c1_ambush_0523890e:

    # maya "The streets of Zan are dangerous at the best of times. You should tread softly, and watch your back."
    maya "在泽恩的街道,你最好还是谨慎小心,留意身后。"

# game/BKchapter1.rpy:639
translate chinese_simplified c1_ambush_df924ee8:

    # sill "Yes Madam."
    sill "是的,女士。"

# game/BKchapter1.rpy:645
translate chinese_simplified c1_ambush_bb91485a:

    # roz "Damn it, they were fast... *pant*"
    roz "该死,他们太快了...*喘气*"

# game/BKchapter1.rpy:647
translate chinese_simplified c1_ambush_038df07a:

    # roz "I couldn't catch them. They scattered like rats, bwahahahaha!"
    roz "我追不上他们。他们像老鼠一样四散逃窜,啊啊啊!"

# game/BKchapter1.rpy:649
translate chinese_simplified c1_ambush_5b74059a:

    # maya "Well, at least we got here in time. Well done."
    maya "好吧,至少我们及时赶到了。干得不错。"

# game/BKchapter1.rpy:651
translate chinese_simplified c1_ambush_d13203fd:

    # roz "But Maya, there's something odd about those guys. One of them recognized me. Do you think..."
    roz "可是,玛雅,那些人有些奇怪。其中一个人认识我。你觉得会不会..."

# game/BKchapter1.rpy:653
translate chinese_simplified c1_ambush_12d82bec:

    # maya "Not here, Roz."
    maya "别在这说,罗兹。"

# game/BKchapter1.rpy:655
translate chinese_simplified c1_ambush_3c41d93c:

    # maya "Let's go."
    maya "我们走吧。"

# game/BKchapter1.rpy:667
translate chinese_simplified c1_ambush_cabcba11:

    # "You and Sill make it back safely to the brothel. You give instructions to tighten security."
    "你和希露平安回到青楼。你下令加强了安全措施。"

# game/BKchapter1.rpy:685
translate chinese_simplified c1_reached_goal_d623bd65:

    # sill happy "Master! Great news! We now have the necessary gold, and we..."
    sill happy "主人！好消息！我们现在有了足够的黄金，而且我们……"

# game/BKchapter1.rpy:687
translate chinese_simplified c1_reached_goal_6f9b202d:

    # gio "Hello, ladies!" with vpunch
    gio "女士们好！" with vpunch

# game/BKchapter1.rpy:691
translate chinese_simplified c1_reached_goal_f19c886a:

    # you "Gio! When did you..."
    you "乔!你什么时候来的..."

# game/BKchapter1.rpy:693
translate chinese_simplified c1_reached_goal_5879e8fc:

    # gio "No matter, old friend! Hand over that gold, and we'll have us a proper license in no time!"
    gio "那不重要,老朋友!把金币给我,我们很快就能得到正式的营业执照!"

# game/BKchapter1.rpy:695
translate chinese_simplified c1_reached_goal_abe2937b:

    # sill sad "'We'?"
    sill sad "'我们'？"

# game/BKchapter1.rpy:697
translate chinese_simplified c1_reached_goal_b62415ce:

    # you "Look, Gio... I would rather take care of this myself. What did you plan to do with this money?"
    you "听着,乔...我想自己来处理。你打算怎么花这笔钱?"

# game/BKchapter1.rpy:699
translate chinese_simplified c1_reached_goal_c5e24bc6:

    # gio "Well, err, I have a contact with the city guard... If we have the right amount, she promised to take care of the paperwork, so that we can get a real license and move into the city itself."
    gio "哦,我有个军队里的熟人...如果我们给她足够的报酬,她答应会帮我们办理所有手续,这样我们就可以进城里做生意了。"

# game/BKchapter1.rpy:702
translate chinese_simplified c1_reached_goal_faf3f64f:

    # gio "You can see her for yourself, of course... I'll send word. *nervous*"
    gio "你可以自己去找她...替我问好。*不安*"

# game/BKchapter1.rpy:704
translate chinese_simplified c1_reached_goal_9a3dd74f:

    # you "Yeah. We'll do that."
    you "好,那就这么做。"

# game/BKchapter1.rpy:708
translate chinese_simplified c1_reached_goal_3202bced:

    # "Go to the {b}watchtower{/b} and meet with the lieutenant."
    "去{b}瞭望塔{/b}找中尉。"

# game/BKchapter1.rpy:740
translate chinese_simplified c1_visit_watchtower_0215bf20:

    # lieutenant "Yes?"
    lieutenant "什么事?"

