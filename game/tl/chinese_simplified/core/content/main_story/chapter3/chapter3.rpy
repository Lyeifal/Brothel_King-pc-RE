    # mizuki "There is really no need to spill your blood. Remove yourself from here, and you'll live. You might even gain from it."
    mizuki "真的没必要流血。离开这里，你就能活命。说不定还能从中获益。"

# game/BKchapter3.rpy:13150
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_11fdb519:

    # extend "" nointeract
    extend "" nointeract

# game/BKchapter3.rpy:13156
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_b8f20607:

    # "You step away from Mizuki and draw your weapon."
    "你离开瑞希，拔出武器。"

# game/BKchapter3.rpy:13160
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_eaa9c9fc:

    # you "No! I can't let you kill her, she's unarmed... Not on my watch."
    you "不！我不能让你杀了她，她手无寸铁……有我在，绝不允许这种事发生。"

# game/BKchapter3.rpy:13162
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_fced6e0d:

    # mizuki angry "Then you die, boy..."
    mizuki angry "然后你就死了，孩子……"

# game/BKchapter3.rpy:13164
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_6449b10c:

    # kenshin "STOP!!!" with vpunch
    kenshin "停止！！！" with vpunch

# game/BKchapter3.rpy:13166
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_5f3c6a08:

    # kenshin "You, Lady! Why are you even trying to kill me?"
    kenshin "你，女人！你为什么要杀我？"

# game/BKchapter3.rpy:13168
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_9bb09a88:

    # mizuki "Why, indeed? Because you're a Mitsuhide from Westmarch, and all the Mitsuhide's must die. Your clan has wronged me, beyond what you can possibly imagine."
    mizuki "为什么？因为你是西境的御秀一族，而所有御秀一族的人都必须死。你的家族对我犯下的罪行，远超你的想象。"

# game/BKchapter3.rpy:13170
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_e00cadd8:

    # kenshin "{i}I{/i} have wronged you? I have never even been to Westmarch! I only had one ancestor there..."
    kenshin "{i}我做错什么了吗？我甚至从未去过西境！我只有一个祖先在那里……"

# game/BKchapter3.rpy:13172
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_f9e76d64:

    # mizuki "Well, it is one too many."
    mizuki "这确实太多了。"

# game/BKchapter3.rpy:13174
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_7cf3cdbe:

    # mizuki "I nearly got your father, 15 years ago, but he died before I could get to him. And now that you are a grown-up woman, I'm afraid it is your turn to pay for the crimes of your ancestors."
    mizuki "十五年前，我差点就抓住了你父亲，但他在我动手之前就去世了。现在你已经长大成人，恐怕轮到你为祖先的罪行付出代价了。"

# game/BKchapter3.rpy:13176
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_fcc853e7:

    # kenshin "Wait, my father? 15 years ago? But he disappeared when I was just a baby!"
    kenshin "等等，我父亲？15年前？但他在我还是婴儿的时候就消失了！"

# game/BKchapter3.rpy:13178
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_180fd115:

    # kenshin "What do you know about my father???" with vpunch
    kenshin "你对我父亲了解多少？" with vpunch

# game/BKchapter3.rpy:13180
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_9d017960:

    # "Mizuki shrugs."
    "瑞希耸了耸肩。"

# game/BKchapter3.rpy:13182
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_ae5b8d1a:

    # mizuki "The demons got to him first, and did the work for me. So there isn't much to tell. I helped the boy fend them off - he was no Mitsuhide."
    mizuki "恶魔先一步控制了他，替我解决了他。所以也没什么好说的。我只是帮那孩子抵挡了一下——他可不是光秀。"

# game/BKchapter3.rpy:13184
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_3ca7f707:

    # kenshin "The boy? What boy?"
    kenshin "那个男孩？哪个男孩？"

# game/BKchapter3.rpy:13186
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_45c29fda:

    # mizuki "The boy he was protecting, and... Who cares? I am not here to answer your questions!" with vpunch
    mizuki "他保护的那个男孩，还有……谁在乎？我不是来回答你们问题的！" with vpunch

# game/BKchapter3.rpy:13188
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_8c320ec6:

    # "Kenshin clenches her fists with fury."
    "剑心愤怒地紧握双拳。"

# game/BKchapter3.rpy:13190
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_aee52e86:

    # kenshin "You will tell me what you know about my father! If I have to punch out all your teeth first, I will!"
    kenshin "你得告诉我你所知道的关于我父亲的一切！就算要先把你的牙都打掉，我也照样做！"

# game/BKchapter3.rpy:13192
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_7ab908f0:

    # mizuki "Ha! You have spirit, I'll give you that. But I am armed, and you are not."
    mizuki "哈！你很有斗志，我承认。但我有武器，而你没有。"

# game/BKchapter3.rpy:13194
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_f837410d:

    # mizuki "It's time to say goodbye to this valley of tears. You'll be better off that way, I promise yo."
    mizuki "是时候和这片泪谷说再见了。我保证，那样对你更好。"

# game/BKchapter3.rpy:13198
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_a8df6d65:

    # "Mizuki gets into a fighting stance. You ready yourself, siding with Kenshin, painfully aware that you are facing a deadly assassin with centuries of fighting experience."
    "水木摆出战斗姿势。你做好准备，站在剑心一边，痛苦地意识到你面对的是一位拥有数百年战斗经验的致命刺客。"

# game/BKchapter3.rpy:13200
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c5db8632:

    # kenshin "Step aside, [MC.name]! Give me a weapon."
    kenshin "[MC.name]，让开！给我武器。"

# game/BKchapter3.rpy:13203
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c3ba7ce7:

    # you "Are you sure, Kenshin?"
    you "剑心，你确定吗？"

# game/BKchapter3.rpy:13205
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_436633d8:

    # "You see the resolve on her face, and know she's the better fighter. You hand her your blade."
    "你从她脸上看到坚定的神情，知道她比你更胜一筹。你把剑递给她。"

# game/BKchapter3.rpy:13210
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_d6552a19:

    # kenshin "I can still use it to parry, so give it to me! If I die, it will be with a weapon in hand."
    kenshin "我还能用它来格挡，所以把它给我！如果我死了，至少手里还拿着武器。"

# game/BKchapter3.rpy:13214
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c30f9bad:

    # you "Here... *toss your weapon*"
    you "给你……*扔掉你的武器*"

# game/BKchapter3.rpy:13222
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_f50739b3:

    # "Kenshin grabs it and immediately shoves you aside, just in time to parry Mizuki's first blow."
    "剑心抓住它，立刻将你推到一边，正好挡住了瑞希的第一击。"

# game/BKchapter3.rpy:13224
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_8b8a256f:

    # mizuki "Ha!"
    mizuki "哈!"

# game/BKchapter3.rpy:13229
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_a2c34448:

    # kenshin "Watch out!"
    kenshin "小心!"

# game/BKchapter3.rpy:13239
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c1ccbeb2:

    # mizuki "Hmph! You fight well, for a youngster."
    mizuki "哼！你年纪轻轻就打得不错。"

# game/BKchapter3.rpy:13257
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_5675b5c2:

    # kenshin "And you're fast, for an old lady... *pant*"
    kenshin "你跑得真快，对于一位老太太来说……*喘气*"

# game/BKchapter3.rpy:13259
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_8083af6e:

    # mizuki "Fufufufu..."
    mizuki "呼呼呼呼..."

# game/BKchapter3.rpy:13261
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_f5c5a7ad:

    # "Ice particles begin to form in the air around Mizuki."
    "水木周围的空气中开始形成冰晶。"

# game/BKchapter3.rpy:13263
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_0d486c38:

    # mizuki "You {i}are{/i} a formidable fighter, I'll give you that. But {i}I{/i} am not a one-trick pony."
    mizuki "你是个很厉害的战士，这一点我承认。但我可不是只会一招鲜的。"

# game/BKchapter3.rpy:13265
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_6239cf7b:

    # "Mizuki starts summoning a powerful ice spell."
    "瑞希开始施展强大的冰系魔法。"

# game/BKchapter3.rpy:13267
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_050d2b84:

    # "Kenshin cowers at the sight of magic, and she starts mumbling a prayer."
    "剑心看到魔法就瑟瑟发抖，她开始喃喃自语地祈祷。"

# game/BKchapter3.rpy:13269
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_abb917c9:

    # kenshin normal "Fear not the shadows, for the stars are vigils that shall ward thee 'gainst the night..."
    kenshin normal "不要惧怕阴影，因为群星是守望者，它们会守护你免受黑夜的侵袭……"

# game/BKchapter3.rpy:13271
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_7e4045b8:

    # you "What's that? A ward?"
    you "那是什么？病房吗？"

# game/BKchapter3.rpy:13273
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_9d77870c:

    # "Kenshin looks scared and vulnerable now, holding to her poor weapon for dear life."
    "剑心现在看起来既害怕又脆弱，紧紧抓住她那可怜的武器，仿佛那是她唯一的救命稻草。"

# game/BKchapter3.rpy:13275
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_de7c9423:

    # kenshin "Fear not the shadows... For the stars are vigils and shall ward thee 'gainst the night... *desperate*"
    kenshin "不要惧怕阴影……因为群星是守望者，它们会守护你免受黑夜的侵袭……*绝望*"

# game/BKchapter3.rpy:13277
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_d2e859c8:

    # "Mizuki freezes dead in her tracks."
    "瑞希愣在了原地，一动不动。"

# game/BKchapter3.rpy:13279
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_f4202b5d:

    # mizuki angry "You! W-What did you just say?" with vpunch
    mizuki angry "你！你刚才说什么？" with vpunch

# game/BKchapter3.rpy:13281
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_0c63c7a1:

    # kenshin "Fear not the shadows, for the stars-"
    kenshin "不要害怕阴影，因为星辰——"

# game/BKchapter3.rpy:13283
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_70c89e32:

    # mizuki "Stop, stop! This phrase you just used... Where did you learn it?!?"
    mizuki "停！停！你刚才用的这句话……你是从哪儿学来的？！"

# game/BKchapter3.rpy:13285
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c4fb65b7:

    # kenshin "What? That's just a prayer to ward off evil, everyone knows it."
    kenshin "什么？那只是驱邪的祈祷文，人人都知道。"

# game/BKchapter3.rpy:13287
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_123dc155:

    # you "An old prayer then? I've never heard it."
    you "那原来是古老的祷文？我从没听过。"

# game/BKchapter3.rpy:13289
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_a73c6efd:

    # mizuki "No. Not everyone knows that."
    mizuki "不，并非人人都知道这一点。"

# game/BKchapter3.rpy:13291
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_0a069e7b:

    # kenshin "Why do you even care! My father taught it to my Mom to soothe my cries, when I was just a baby."
    kenshin "你干嘛这么在意！我小时候，我爸教我妈用这个方法哄我哭闹。"

# game/BKchapter3.rpy:13293
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_9fed42c4:

    # kenshin "And then he abandoned us. It's the last thing I remember from him."
    kenshin "然后他就抛弃了我们。这是我对他最后的记忆。"

# game/BKchapter3.rpy:13295
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_d08df107:

    # mizuki "Where! Where did your father learn it?"
    mizuki "你父亲是从哪里学来的？"

# game/BKchapter3.rpy:13297
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_d0c9bbd4:

    # "You watch Mizuki, puzzled. Her face has changed, and now it's like she's the one looking scared."
    "你疑惑地看着瑞希。她的表情变了，现在看起来好像是她害怕了。"

# game/BKchapter3.rpy:13299
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_98052ff9:

    # kenshin "From his parents before, maybe? Why does it even matter?!?" with vpunch
    kenshin "或许是他父母以前送的？这又有什么关系呢？！" with vpunch

# game/BKchapter3.rpy:13301
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_d4ff763d:

    # mizuki normal "Who was your ancestor in Westmarch? Do you know, little girl?"
    mizuki normal "你的祖先在西境是谁？你知道吗，小姑娘？"

# game/BKchapter3.rpy:13303
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_31b78523:

    # "Her voice is suddenly very calm, begging almost. Kenshin hesitates, then shrugs."
    "她的声音突然变得异常平静，近乎哀求。剑心犹豫了一下，然后耸了耸肩。"

# game/BKchapter3.rpy:13305
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_2d9720be:

    # kenshin "Yes, I know. It was a great shame on my family... Until my father became a deserter, and made it seem trivial in comparison."
    kenshin "是的，我知道。这曾是我家的一大耻辱……直到我父亲成了逃兵，相比之下，这件事似乎微不足道了。"

# game/BKchapter3.rpy:13307
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_4fa16451:

    # you "What is that all about?"
    you "这到底是怎么回事？"

# game/BKchapter3.rpy:13309
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_df79a425:

    # kenshin "My Westmarch ancestor was a noblewoman who fled from Telago, after falling with child, out of wedlock."
    kenshin "我的西境祖先是一位贵族女子，她未婚先孕后逃离了泰拉戈。"

# game/BKchapter3.rpy:13311
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_5edaa5b3:

    # kenshin "The father was some Mitsuhide prince, but he got himself killed in a siege before they ever had a chance to tie the knot. She was driven out of town in shame, but her child kept the name Mitsuhide, and ..."
    kenshin "父亲是位名叫光秀的王子，但在他们成婚之前，便在一场围城战中阵亡。她羞愧地被驱逐出城，但她的孩子却保留了光秀这个姓氏，并且……"

# game/BKchapter3.rpy:13313
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_d81d24c0:

    # "Mizuki remains speechless, lost in her thoughts."
    "美月沉默不语，陷入沉思。"

# game/BKchapter3.rpy:13315
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_860718d9:

    # kenshin "Here, is your curiosity satisfied now, you old harpy? Do you want me to unfold my genealogy all the way to the Goliath destroying the North?"
    kenshin "好了，你这老妖婆，现在你的好奇心满足了吗？要不要我把我的家谱一直讲到摧毁北方的巨人歌利亚？"

# game/BKchapter3.rpy:13319
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_2d912c4e:

    # kenshin "Now, stand up and fight!" with vpunch
    kenshin "现在，站起来战斗！" with vpunch

# game/BKchapter3.rpy:13325
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_2adf068f:

    # "Something unexpected happens. Mizuki drops her weapon to the ground."
    "意想不到的事情发生了。瑞希的武器掉在了地上。"

# game/BKchapter3.rpy:13327
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_ee969ff4:

    # mizuki sad "I see it now... I see it so clearly... Your face..."
    mizuki sad "我现在明白了……我看得如此清楚……你的脸……"

# game/BKchapter3.rpy:13329
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_6dc3ec87:

    # kenshin "What in Arios's name is going on here??? [MC.name], do you even know what this crazy woman is babbling about???"
    kenshin "这到底是怎么回事？？？[MC.name]，你知道这个疯女人在胡言乱语些什么吗？？？"

# game/BKchapter3.rpy:13331
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_8405dc91:

    # you "Maybe... I think I do..."
    you "也许……我想我的确如此……"

# game/BKchapter3.rpy:13333
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_125d1522:

    # mizuki "My son... My son lives... He lives through you..."
    mizuki "我的儿子……我的儿子还活着……他通过你而活……"

# game/BKchapter3.rpy:13335
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_e1fc06cc:

    # kenshin "What?!?"
    kenshin "什么?!?"

# game/BKchapter3.rpy:13337
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_cf00f8ea:

    # you "Her son... Well, he got himself killed in a siege, two centuries ago. Just like the prince in your ancestor's story..."
    you "她的儿子……嗯，他在两百年前的一场围城战中丧生了。就像你祖先故事里的那位王子一样……"

# game/BKchapter3.rpy:13339
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_a543b7f0:

    # kenshin "Her son? Two centuries ago? What are you even saying???"
    kenshin "她的儿子？两百年前？你在说什么？？？"

# game/BKchapter3.rpy:13341
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_d656a187:

    # you "I know, I know. Bear with me."
    you "我知道，我知道。请耐心听我说完。"

# game/BKchapter3.rpy:13343
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_5f260600:

    # you "Her son was young, but apparently old enough to fool around. It seems like you're the ultimate fruit of that dalliance."
    you "她儿子年纪虽小，但显然已经到了到处乱搞的年纪。看来你就是他们那段风流韵事的最终成果。"

# game/BKchapter3.rpy:13345
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_68b77441:

    # mizuki "'Fear not the shadows, for the stars are vigils and shall ward thee 'gainst the night'."
    mizuki "不要害怕阴影，因为星星是守望者，它们会守护你免受黑夜的侵袭。"

# game/BKchapter3.rpy:13347
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_b54afa7f:

    # kenshin "That's what I said!"
    kenshin "我就是这么说的！"

# game/BKchapter3.rpy:13349
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_2a82a333:

    # mizuki "My son... He knew that nursery rhyme by heart. I wrote it for him, inspired by an old epic about Shalia."
    mizuki "我的儿子……他能把那首童谣背得滚瓜烂熟。这首歌是我为他写的，灵感来自一部关于莎莉娅的古老史诗。"

# game/BKchapter3.rpy:13351
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_5929f762:

    # kenshin "I-It doesn't make any sense... Who is this lady???"
    kenshin "这……这根本说不通……这位女士是谁？？？"

# game/BKchapter3.rpy:13353
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_6a4723af:

    # "Kenshin is at a loss, and seems about to burst into a fit of anger or tears. But, surprisingly, you see that it is now Mizuki who is crying."
    "剑心不知所措，似乎即将爆发怒火或泪水。但出乎意料的是，哭泣的却是瑞希。"

# game/BKchapter3.rpy:13355
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_f7fe6e76:

    # kenshin "What in the name of Arios is going on?"
    kenshin "这到底是怎么回事？"

# game/BKchapter3.rpy:13357
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_ea89879c:

    # mizuki "Kenshin, my child, I owe you the deepest apology. I'm so grateful now that I didn't kill your father. What a crime it would have been... But my son lives on!"
    mizuki "剑心，我的孩子，我欠你最深的歉意。我现在无比庆幸我没有杀了你的父亲。那该是多么可怕的罪行啊……但我的儿子还活着！"

# game/BKchapter3.rpy:13359
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_a5fe22b5:

    # kenshin "My father!!! You said you've seen him die, 15 years ago... Tell me what you know, please!"
    kenshin "我的父亲！！！你说你亲眼目睹他去世，那是15年前的事了……请告诉我你所知道的一切！"

# game/BKchapter3.rpy:13361
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_14be6b19:

    # mizuki "Of course, my dear, this is the least I can do..."
    mizuki "当然，亲爱的，这是我至少应该做的……"

# game/BKchapter3.rpy:13363
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_54f9e2e6:

    # kenshin "Tell us, now. Who killed him?"
    kenshin "现在就告诉我们，是谁杀了他？"

# game/BKchapter3.rpy:13365
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_e7116471:

    # mizuki "Not who... What. Demons from hell, I kid you not."
    mizuki "不是谁……而是什么。是来自地狱的恶魔，我可没开玩笑。"

# game/BKchapter3.rpy:13367
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_6d621eb5:

    # you "Demons? You must be kidding!"
    you "恶魔？你在开玩笑吧！"

# game/BKchapter3.rpy:13369
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_7cb0aadf:

    # mizuki "I never kid. I was as surprised as you are."
    mizuki "我从不开玩笑。我和你一样感到惊讶。"

# game/BKchapter3.rpy:13371
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c06951c1:

    # kenshin "Why would demons go after my father?"
    kenshin "恶魔为什么要追杀我父亲？"

# game/BKchapter3.rpy:13373
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_7c9b7a15:

    # mizuki "I don't know, but it's clear he was in hiding. He lived in a hut amidst the wilderness, alone with the boy..."
    mizuki "我不知道，但很明显他躲藏了起来。他和那个男孩独自住在荒野中的一间小屋里……"

# game/BKchapter3.rpy:13375
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_a5d0cb34:

    # kenshin "A boy? What boy?"
    kenshin "男孩？什么男孩？"

# game/BKchapter3.rpy:13377
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_d731c6ac:

    # mizuki "Oh, I'm not sure', a runt of 8 or 9 years... Not his, that's for sure. But he protected him with his life."
    mizuki "哦，我不确定，大概八九岁吧……肯定不是他的孩子。但他用生命保护了他。"

# game/BKchapter3.rpy:13379
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_eaee065a:

    # mizuki "When I finally tracked him all the way to his hideout, I heard a commotion. I approached through the bushes, and there I saw this group of snarly demons fighting the old man and his child."
    mizuki "当我终于追踪他到他的藏身之处时，我听到一阵骚动。我穿过灌木丛走近，看到一群凶神恶煞的恶魔正在与那个老人和他的孩子搏斗。"

# game/BKchapter3.rpy:13381
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_6fb7063a:

    # mizuki "Your father fought like a lion, I have to say, but eventually he got gutted by claws and rended by fangs, and that was it."
    mizuki "不得不说，你父亲像狮子一样战斗，但最终他被利爪撕咬，被尖牙撕裂，就此结束了生命。"

# game/BKchapter3.rpy:13383
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_a359c460:

    # mizuki "The child was swinging a sword as big as him wildly to keep the demons away, but it was clear the demons were going to slaughter him. One of them clawed at his face and took his eyes out."
    mizuki "孩子挥舞着一把和他一样大的剑，拼命地想要击退恶魔，但很明显，恶魔们是要杀了他。其中一个恶魔抓伤了他的脸，挖出了他的双眼。"

# game/BKchapter3.rpy:13385
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c0672f0c:

    # mizuki "I was not going to reveal myself, but I don't know what came over me, I took pity on him. I never could stand to see a child suffer."
    mizuki "我原本没打算暴露身份，但不知怎么的，我竟然同情他。我实在不忍心看到孩子受苦。"

# game/BKchapter3.rpy:13387
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_0691bd06:

    # mizuki "Before the demons could finish him, I jumped out of the bushes and struck the demons from the back when they least expected it. It was over before they knew I was on them."
    mizuki "在恶魔们还没来得及解决他之前，我从灌木丛里跳了出来，趁恶魔们毫无防备，从背后袭击了他们。还没等他们反应过来，战斗就已经结束了。"

# game/BKchapter3.rpy:13389
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_567d18eb:

    # kenshin "What of the child?"
    kenshin "孩子怎么办？"

# game/BKchapter3.rpy:13391
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_0a67cdff:

    # mizuki "His wounds were nasty, but I helped him as best I could. There was nothing I could do about his eyes, though. He was a trooper, he didn't whine even once."
    mizuki "他的伤口很严重，但我尽力帮助了他。不过，他的眼睛我却无能为力。他真是个坚强的孩子，一声都没抱怨过。"

# game/BKchapter3.rpy:13393
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_16d70ceb:

    # mizuki "Once he was stable, I left him to rest inside the hut while I went looking for help. I arranged for word about the attack to reach the next village, hoping they'd go and rescue him."
    mizuki "他情况稳定后，我让他待在小屋里休息，自己去找人帮忙。我安排人把袭击的消息传到邻村，希望他们能去救他。"

# game/BKchapter3.rpy:13395
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_56fea734:

    # mizuki "But later I was told the rescue party only found your father's body... Perhaps more demons eventually came back to claim the boy, or he decided to hide from the villagers."
    mizuki "但后来我听说救援队只找到了你父亲的尸体……或许后来有更多的恶魔回来掳走了那个男孩，或者他决定躲避村民。"

# game/BKchapter3.rpy:13397
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_e13d12cc:

    # you "A blind boy... Alone in the forest..."
    you "一个失明的男孩……独自一人在森林里……"

# game/BKchapter3.rpy:13399
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_fcc2b5be:

    # kenshin "Demons... Demons killed my father? But why? And who was that kid he was protecting when he should have been with us? With... Me..."
    kenshin "恶魔……恶魔杀死了我的父亲？为什么？他本该和我们在一起，却在保护那个孩子，那孩子又是谁？和……我在一起……"

# game/BKchapter3.rpy:13401
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_6e1b7404:

    # mizuki "This is all I know. I'm sorry for you loss, child..."
    mizuki "我只知道这些。孩子，我很遗憾你失去了亲人……"

# game/BKchapter3.rpy:13403
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_5b316161:

    # mizuki "But listen. I only want you to live a happy life. Do not dwell on the past as I have. It is not worth it."
    mizuki "但是听我说，我只希望你过上幸福的生活。不要像我一样沉湎于过去，那样不值得。"

# game/BKchapter3.rpy:13405
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_4193d372:

    # kenshin "Are you finally going to tell me what's going on? Hey! Come back!"
    kenshin "你终于要告诉我到底发生了什么事了吗？嘿！回来！"

# game/BKchapter3.rpy:13411
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_19aed083:

    # "Mizuki simply {i}vanishes{/i} into thin air. Kenshin is left rubbing her eyes in disbelief."
    "瑞希就这样凭空消失了。剑心难以置信地揉着眼睛。"

# game/BKchapter3.rpy:13413
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c36c622c:

    # kenshin "[MC.name]... Who was that lady?"
    kenshin "[MC.name]... 那位女士是谁？"

# game/BKchapter3.rpy:13415
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c4b06dba:

    # "Her voice is calmer now."
    "她的声音现在平静多了。"

# game/BKchapter3.rpy:13417
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_877ca256:

    # you "Well, if my calculations are correct... You were in the presence of your great-great-great-great-great-grandmother."
    you "如果我没算错的话……你当时是在你曾曾曾曾祖母的面前。"

# game/BKchapter3.rpy:13419
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_12e71cb7:

    # kenshin "Ah."
    kenshin "啊。"

# game/BKchapter3.rpy:13423
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_e0ebc4e7:

    # "You try your best to explain Mizuki's past to Kenshin, but she quickly gets lost in her own thoughts."
    "你尽力向剑心解释瑞希的过去，但她很快就陷入了自己的思绪中。"

# game/BKchapter3.rpy:13425
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_98c47b8d:

    # "In the end she leaves without a word, and you wonder if any of your explanation has got through to her."
    "最后她一言不发地离开了，你不禁怀疑你的解释她是否听进去了。"

# game/BKchapter3.rpy:13427
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_4bd984c3:

    # "No blood was shed today. But is this really the last you'll see of Mizuki?"
    "今天没有流血。但这真的是你最后一次见到瑞希吗？"

# game/BKchapter3.rpy:13436
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_86dd6b7b:

    # you "Suppose I were to get out of your way... What's in it for me?"
    you "假设我让开……我能得到什么好处？"

# game/BKchapter3.rpy:13438
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_72cf9411:

    # mizuki happy "Aside from your life, you mean? Well..."
    mizuki happy "你是说除了你自己的生活之外？嗯……"

# game/BKchapter3.rpy:13440
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c088d444:

    # "Mizuki steps close, putting her arm on your chest and whispering in your ear."
    "美月走近你，将手臂放在你的胸口，在你耳边低语。"

# game/BKchapter3.rpy:13442
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_fd0070fa:

    # mizuki "(Once I dispatch that Mitsuhide cockroach... I can be yours...)"
    mizuki "（等我干掉那只光秀蟑螂……我就可以属于你了……）"

# game/BKchapter3.rpy:13444
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_3c89e8f2:

    # you "Mine? *sweat*"
    you "我的？*冒汗*"

# game/BKchapter3.rpy:13446
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_72b57ab6:

    # "Mizuki giggles enticingly."
    "瑞希发出诱人的咯咯笑声。"

# game/BKchapter3.rpy:13448
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_107913d1:

    # mizuki "(Quite literally, my boy...)"
    mizuki "（孩子，这话一点儿也不假……）"

# game/BKchapter3.rpy:13450
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_6b2a5bac:

    # "You wonder what she means by that, and it gets your mind racing."
    "你琢磨着她这话是什么意思，思绪开始飞转。"

# game/BKchapter3.rpy:13460
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_f3552186:

    # you "Well, you make a convincing argument. This isn't my fight."
    you "嗯，你的论点很有说服力。但这并非我该管的事。"

# game/BKchapter3.rpy:13465
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_673a5d52:

    # kenshin "No! [MC.name], what are you doing?"
    kenshin "不！[MC.name]，你在做什么？"

# game/BKchapter3.rpy:13467
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_642103e5:

    # you "Sorry Kenshin, but you're on your own. Maybe you should have thought twice before pissing me off at the castle."
    you "抱歉了，剑心，你只能靠自己了。或许你当初在城堡里惹我生气之前就应该好好想想。"

# game/BKchapter3.rpy:13469
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_39dcc938:

    # "You start to walk away, without looking back."
    "你转身离开，头也不回。"

# game/BKchapter3.rpy:13471
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_38dd6fbb:

    # kenshin "No-"
    kenshin "不-"

# game/BKchapter3.rpy:13481
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c66f9eb3:

    # "You try to block out the sounds of Kenshin's agony coming from behind you. Fortunately, it is quickly over."
    "你努力不去听身后剑心痛苦的呻吟声。幸运的是，这一切很快就结束了。"

# game/BKchapter3.rpy:13487
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_16ca026e:

    # mizuki normal "'Tis done. My life - or death's - work, is over."
    mizuki normal "一切都结束了。我毕生——或者说死亡——的事业，已经完成了。"

# game/BKchapter3.rpy:13489
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_48dbeae2:

    # you "Are you going to celebrate?"
    you "你们打算庆祝吗？"

# game/BKchapter3.rpy:13491
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_a7ff313c:

    # mizuki "No. I just feel nothing now. Empty."
    mizuki "不，我现在什么感觉都没有了。空虚。"

# game/BKchapter3.rpy:13493
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_10ba61fc:

    # mizuki "As a witness, I should normally kill you where you stand, but... I feel too lazy to do even that."
    mizuki "作为目击证人，我本应该当场杀了你，但是……我连这都懒得做。"

# game/BKchapter3.rpy:13495
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_223b443b:

    # you "Whatever are you going to do?"
    you "你打算怎么办？"

# game/BKchapter3.rpy:13497
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_b2d50b83:

    # mizuki "Well... There's nothing left for me to accomplish in this world. I guess I could just rest..."
    mizuki "唉……我在这世上已经没有什么事情要做了。我想我可以安息了……"

# game/BKchapter3.rpy:13499
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_6558b77d:

    # "Mizuki gives you a faint smile."
    "瑞希淡淡地笑了笑。"

# game/BKchapter3.rpy:13501
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_f8da2ca1:

    # mizuki "But I owe you, as the person who helped me get my final revenge."
    mizuki "但我欠你一个人情，因为是你帮助我完成了最后的复仇。"

# game/BKchapter3.rpy:13503
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_d3936306:

    # mizuki "Why don't you let me join you? I'll make myself useful."
    mizuki "为什么不让我加入你们呢？我会尽我所能的。"

# game/BKchapter3.rpy:13505
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_fc2c64f7:

    # you "Me? I'm a brothel owner!"
    you "我？我是个妓院老板！"

# game/BKchapter3.rpy:13507
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_7bda78f9:

    # mizuki "I know that. I'd still join you."
    mizuki "我知道。但我还是会加入你们。"

# game/BKchapter3.rpy:13509
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_c9acd4fd:

    # you "Really? Why?"
    you "真的吗？为什么？"

# game/BKchapter3.rpy:13511
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_75e3848e:

    # mizuki "Now that killing has lost its edge, let's see if sex can still make me feel anything. I have centuries of experience; you won't regret it."
    mizuki "既然杀戮已不再令我兴奋，那就看看性爱是否还能让我有所感觉。我拥有数百年的经验，你不会后悔的。"

# game/BKchapter3.rpy:13515
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_5be9e914:

    # you "Sure, of course I'll have you."
    you "当然，我当然愿意收下你。"

# game/BKchapter3.rpy:13517
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_0b401da9:

    # mizuki "It is a deal, then. I'll meet you at your place."
    mizuki "那就这么定了。我到你那儿去。"

# game/BKchapter3.rpy:13529
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_7fa383b0:

    # you "I'm not sure I need a ghost killer among my ranks, sorry. You should look elsewhere."
    you "抱歉，我不太确定我的队伍里是否需要一个捉鬼专家。你应该另寻他人。"

# game/BKchapter3.rpy:13531
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_3f5923e3:

    # mizuki sad "Ouch, you could have been more of a gentleman about it. Rejection stings."
    mizuki sad "哎哟，你本可以更有绅士风度一些。被拒绝确实很伤人。"

# game/BKchapter3.rpy:13533
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_9abcbacc:

    # mizuki "So be it, I shall leave Zan forever. Pray that we never meet again."
    mizuki "就这样吧，我将永远离开赞恩。祈祷我们永不再见。"

# game/BKchapter3.rpy:13537
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_4013d631:

    # "Mizuki leaves, and you heave a sigh of relief to know there is one less killer in the city."
    "瑞希离开了，你松了一口气，因为你知道城市里少了一个杀手。"

# game/BKchapter3.rpy:13539
translate chinese_simplified c3_mizuki_kenshin_confrontation_menu_48426ce5:

    # you "I should inform the Princess about these unfortunate events. I hope the news of her Lady Commander's demise won't hit her too hard."
    you "我应该将这些不幸的事情告知公主殿下。我希望她麾下女指挥官的死讯不会对她打击太大。"

# game/BKchapter3.rpy:13585
translate chinese_simplified mizuki_brothel_service_43130bae:

    # "Mizuki serviced a customer last night."
    "昨晚，Mizuki接待了一位顾客。"

# game/BKchapter3.rpy:13592
translate chinese_simplified mizuki_brothel_service_aa90ad12:

    # customer "Hmmm, nice and wet... I love being with a real mature woman."
    customer "嗯，又湿又舒服……我喜欢和成熟的女人在一起。"

# game/BKchapter3.rpy:13594
translate chinese_simplified mizuki_brothel_service_263a4f05:

    # mizuki naked "Ah, it's good, keep doing that..."
    mizuki naked "啊，很好，继续保持……"

# game/BKchapter3.rpy:13596
translate chinese_simplified mizuki_brothel_service_916b90a6:

    # "The customer is young and inexperienced, but Mizuki is teaching him how to please a woman."
    "顾客年轻缺乏经验，但瑞希正在教他如何取悦女性。"

# game/BKchapter3.rpy:13598
translate chinese_simplified mizuki_brothel_service_81ca91b5:

    # customer "My girlfriend's my age, but she won't let me do anything... It's much better to do it with you!"
    customer "我女朋友和我同龄，但她什么都不让我做……和你一起做就好多了！"

