    # you "Homura is your girlfriend?"
    you "焰是你的女朋友吗？"

# game/BKchapter3.rpy:20289
translate chinese_simplified c3_confrontation_25c91a19:

    # homura "I-It... It's complicated."
    homura "这……这很复杂。"

# game/BKchapter3.rpy:20292
