translate chinese_simplified c3_haruka_rescue_ad4bdb6d:

    # hound_knight "Actually, I remember you... We had some fun last time with you, I recall."
    hound_knight "其实我记得你...上次我们和你玩得很开心，我记得。"

# game/BKchapter3.rpy:16392
translate chinese_simplified c3_haruka_rescue_1e1dac3a:

