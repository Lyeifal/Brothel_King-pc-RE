    # you "AAAHOOYAOUCH!!!" with vpunch
    you "啊啊啊啊！！！" with vpunch

# game/BKstory_events.rpy:17759
translate chinese_simplified trade_50_resources_d1652d3e:

    # "Through tears of pain, you still manage to catch a glimpse of her cleavage, peeking at her ample bosom and her perky nipples, rubbing against her white tunic."
    "即使在痛苦的泪水中,你还是瞥见了她的乳沟,欣赏她那丰满的双乳和挺立的乳头,在白色的长袍下若隐若现。"

# game/BKstory_events.rpy:17763
translate chinese_simplified trade_50_resources_5c9bcd0f:

    # you "Worth... it... *pass out*"
    you "算是值得了...我不行了"

# game/BKstory_events.rpy:17768
translate chinese_simplified trade_50_resources_d1656d33:

    # "You wake up crumpled in the dust in front of the market. You crawl back home, your nuts hurting like hell."
    "你在集市前的地面上醒来,灰头土脸地爬回家,你的腰痛得像地狱一样。"

# game/BKstory_events.rpy:17775
translate chinese_simplified trade_50_resources_7d80b4a3:

    # you "I'd like some advanced resources as a reward. I'm sure you can spare some."
    you "我想要一些高级资源作为奖励。我相信你可以分点给我。"

# game/BKstory_events.rpy:17779
translate chinese_simplified trade_50_resources_cceb6bb5:

    # bast "I knew you would try and bargain... *sigh*"
    bast "我就知道你会想要讨价还价...叹气"

