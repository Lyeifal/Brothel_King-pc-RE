    you "哎哟..."

# game/BKstory_events.rpy:17740
translate chinese_simplified trade_50_resources_96032543:

    # you "As my reward, I choose... Fondling your juicy boobies!"
    you "作为奖赏,我选择...摸你丰满的胸部!"

# game/BKstory_events.rpy:17744
translate chinese_simplified trade_50_resources_14bb38f4:

    # you "Come here... *drool*"
    you "过来...*流口水*"

# game/BKstory_events.rpy:17749
translate chinese_simplified trade_50_resources_48864b13:

    # "Matter-of-factly, Bast grabs you by the shoulders and knees you right in the balls."
    "巴斯特冷静地抓住你的肩膀,猛击你的下体。"

# game/BKstory_events.rpy:17753
