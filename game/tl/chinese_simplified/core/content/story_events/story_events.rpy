# game/BKstory_events.rpy:3257
translate chinese_simplified farm_meet_goldie_menu_ad0d85f5:

    # you "Nightmares?"
    you "噩梦?"

# game/BKstory_events.rpy:3259
translate chinese_simplified farm_meet_goldie_menu_d7311d7a:

    # goldie "Yes. And worse. It's the curse, you see..."
    goldie "是的。更糟的是,这里有诅咒存在..."

# game/BKstory_events.rpy:3265
translate chinese_simplified farm_meet_goldie_menu_61f9b612:

    # you "Can't you just hire more people?"
    you "你不能雇佣更多人来帮忙吗?"

# game/BKstory_events.rpy:3267
translate chinese_simplified farm_meet_goldie_menu_f7fba8a8:

    # goldie "I don't have the coin. Besides..."
    goldie "我没有那么多钱。况且..."

# game/BKstory_events.rpy:3269
translate chinese_simplified farm_meet_goldie_menu_a577ad0e:

    # you "What?"
    you "什么?"

# game/BKstory_events.rpy:3271
translate chinese_simplified farm_meet_goldie_menu_6e86728a:

    # goldie "They'd run away. Just like the others. They all did."
    goldie "他们会逃走的。就像其他人一样。他们全都离开了。"

# game/BKstory_events.rpy:3273
translate chinese_simplified farm_meet_goldie_menu_90569b8f:

    # you "Away from what?"
    you "逃离什么?"

# game/BKstory_events.rpy:3275
translate chinese_simplified farm_meet_goldie_menu_be4365ec:

    # goldie "The terrible curse that struck this place."
    goldie "这片土地上的可怕诅咒。"

# game/BKstory_events.rpy:3281
translate chinese_simplified farm_meet_goldie_menu_3b8b2125:

    # you "Your animals are dying? Why?"
    you "你的动物为什么会死?"

# game/BKstory_events.rpy:3283
translate chinese_simplified farm_meet_goldie_menu_9d67d86a:

    # goldie "All the animals have taken ill. Pig, cow, chicken, it matters not. Even cats and dogs know to avoid this area."
    goldie "所有的动物都生病了。不论是猪、牛还是鸡,甚至连猫狗也知道要远离这里。"

# game/BKstory_events.rpy:3285
translate chinese_simplified farm_meet_goldie_menu_b1755143:

    # you "What's going on with them?"
    you "它们出了什么问题?"

# game/BKstory_events.rpy:3287
translate chinese_simplified farm_meet_goldie_menu_07799540:

    # goldie "They are restless and terrified, and they won't go one step towards the old farmhouse."
    goldie "他们坐立不安,恐惧万分,一步也不愿靠近那座老农舍。"

# game/BKstory_events.rpy:3289
translate chinese_simplified farm_meet_goldie_menu_09ae66cf:

    # goldie "Their milk turns sour. They have stopped reproducing, and all those that were pregnant miscarried."
    goldie "他们的奶变酸了。它们停止了繁衍,所有怀孕的都流产了。"

# game/BKstory_events.rpy:3291
translate chinese_simplified farm_meet_goldie_menu_7649cf0b:

    # goldie "Some died in the night, from sudden heart attacks. The doctor said they died of fright."
    goldie "有些在夜间猝死,医生说是被吓死的。"

# game/BKstory_events.rpy:3293
translate chinese_simplified farm_meet_goldie_menu_aff13949:

    # goldie "I have sold all of the animals that were still healthy... Now I am left with a few sickly ones that might soon succumb to this evil."
    goldie "我已经卖掉了所有还健康的牲畜...现在只剩下几头病殃殃的,也许很快就会被这股邪恶吞噬。"

# game/BKstory_events.rpy:3297
translate chinese_simplified farm_meet_goldie_menu_e6302e08:

    # goldie "At this rate, I won't have any livestock left by the end of the season."
    goldie "这样下去,到季末我就一头牲畜也不会剩下了。"

# game/BKstory_events.rpy:3303
translate chinese_simplified farm_meet_goldie_menu_fa836c2e:

    # you "What was that about a curse?"
    you "这听起来像是有什么诅咒？"

# game/BKstory_events.rpy:3305
translate chinese_simplified farm_meet_goldie_menu_876ac2ec:

    # goldie "It's the old farm. A terrible place, forsaken by the gods."
    goldie "就是那座老农舍。一个可怕的地方,被诸神遗弃了。"

# game/BKstory_events.rpy:3307
translate chinese_simplified farm_meet_goldie_menu_0cd0886a:

    # goldie "After my father passed away, we discovered it belonged to our family on some old, parched document. My eldest brother thought we had struck gold."
    goldie "父亲去世后,我们在一份发黄的文书上发现它属于我们家族。大哥认为这是捡到宝了。"

# game/BKstory_events.rpy:3309
translate chinese_simplified farm_meet_goldie_menu_24bfabc2:

    # goldie "But the property had been locked shut and tight for as long as anyone could remember."
    goldie "但那片地址一直被严严实实地锁着,谁都不敢进去。"

# game/BKstory_events.rpy:3311
translate chinese_simplified farm_meet_goldie_menu_7276e8bc:

    # goldie "My big brother wouldn't heed the superstitious warnings of some of the older servants. One night, he took an axe and broke in."
    goldie "可大哥不信那些仆人的迷信威慑,有一天晚上他拿着斧头闯了进去。"

# game/BKstory_events.rpy:3313
translate chinese_simplified farm_meet_goldie_menu_c942a8d5:

    # goldie "I don't know what he found in there. After an hour, he ran out, his eyes wild, raving like a mad man. His hair had turned completely white."
    goldie "我不知道他在里面发现了什么。一个小时后他疯狂地跑了出来,头发全白了。"

# game/BKstory_events.rpy:3315
translate chinese_simplified farm_meet_goldie_menu_8756e0fa:

    # you "Wow..."
    you "哇..."

# game/BKstory_events.rpy:3317
translate chinese_simplified farm_meet_goldie_menu_b12d9edf:

    # goldie "We couldn't get anything out of him, only that the place was cursed. He grabbed a barrel of lantern oil, and before anyone could stop him, he ran away into the night."
    goldie "我们什么也问不出他,他只是说那里受到了诅咒。他抓了一桶煤油就夜里逃走了,没人能阻止他。"

# game/BKstory_events.rpy:3319
translate chinese_simplified farm_meet_goldie_menu_d384ed43:

    # goldie "He perished in the fire that engulfed the farm that night. I can still hear his screams echoing in the night, chilling our whole family to the bone."
    goldie "那天夜里农舍烧了起来,他就这么死在了火场里。我仍能听到他凄厉的惨叫在夜里回荡,使我们全家胆战心惊。"

# game/BKstory_events.rpy:3321
translate chinese_simplified farm_meet_goldie_menu_dae0ec55:

    # you "..."
    you "..."

# game/BKstory_events.rpy:3323
translate chinese_simplified farm_meet_goldie_menu_469c0599:

    # goldie "The next day, the farm was still standing. The grass outside was thoroughly burned, but the building was left untouched."
    goldie "第二天,农舍依旧矗立在那里。外面的草地被烧焦了,但房子却完好无损。"

# game/BKstory_events.rpy:3325
translate chinese_simplified farm_meet_goldie_menu_e2a79765:

    # you "Magic..."
    you "魔法..."

# game/BKstory_events.rpy:3327
translate chinese_simplified farm_meet_goldie_menu_eb19e0ff:

    # goldie "Foul magic at work, for sure. Since then, the few that have dared enter it haven't returned, or came out frightened out of their mind."
    goldie "一定是什么邪恶的魔法在作祟。从那以后,敢于进去的人要么就再也没有回来,要么就吓得魂不附体。"

# game/BKstory_events.rpy:3329
translate chinese_simplified farm_meet_goldie_menu_1b26523c:

    # goldie "We would have been content to leave this cursed place alone like we did before... But {i}{b}something{/b}{/i} stirred when my brother cracked it open... And it's been a blight on the crops and cattle around the farm ever since."
    goldie "要不是我哥打开了那扇门{i}{b}有东西{/b}{/i} 逃脱了...我们早就把这块被诅咒的地方抛在脑后了。但从那以后,农场周围的庄稼和牲畜就一直受到了它的祸害。"

# game/BKstory_events.rpy:3331
translate chinese_simplified farm_meet_goldie_menu_157719b7:

    # goldie "Even humans fall victims to it. The night terrors, the hallucinations..."
    goldie "甚至连人类也逃不过它的魔爪。噩梦,幻觉..."

# game/BKstory_events.rpy:3333
translate chinese_simplified farm_meet_goldie_menu_a43eac7b:

    # goldie "Several of my people went insane. The rest ran off when they got too scared, or when I couldn't pay them anymore."
    goldie "我的不少人都发了疯,其他人则在害怕或我付不起工钱时逃跑了。"

# game/BKstory_events.rpy:3335
translate chinese_simplified farm_meet_goldie_menu_24c848dc:

    # you "But you remain?"
    you "但你为何还留在这里？"

# game/BKstory_events.rpy:3337
translate chinese_simplified farm_meet_goldie_menu_a5ab99e7:

    # goldie "This is my father's land. I am the head of this family now. What would I do out there? Become a beggar, or a whore?"
    goldie "这里是我父亲的地,我现在是这个家的家主了。我能去哪里?去当乞丐,还是当妓女?"

# game/BKstory_events.rpy:3339
translate chinese_simplified farm_meet_goldie_menu_5d1d56f3:

    # goldie "No way."
    goldie "绝对不行。"

# game/BKstory_events.rpy:3341
translate chinese_simplified farm_meet_goldie_menu_896d5da5:

    # goldie "I'll keep working twice as hard. Things could improve. I have to keep hope."
    goldie "我会更加努力工作。情况也许会好转的。我必须保持希望。"

# game/BKstory_events.rpy:3348
translate chinese_simplified farm_meet_goldie_menu_896bc323:

    # you "What is this 'farm' you speak of?"
    you "你说的这个'农场'指的是什么？"

# game/BKstory_events.rpy:3350
translate chinese_simplified farm_meet_goldie_menu_ca1a6dcb:

    # goldie "It's the large compound behind me. You can see it in the distance, across the fields."
    goldie "就是我身后那座大房子。你可以从这里看到它,在田野的那头。"

# game/BKstory_events.rpy:3352
translate chinese_simplified farm_meet_goldie_menu_0f4f5f96:

    # goldie "It is home to something so dark and evil that it is felt even from here. The land is dying from it."
    goldie "那里有着一股黑暗而邪恶的气息,连这里都能感受到。这片土地正在被它所毒害。"

# game/BKstory_events.rpy:3354
translate chinese_simplified farm_meet_goldie_menu_7a83fa2b:

    # you "Dying?"
    you "毒害？"

# game/BKstory_events.rpy:3356
translate chinese_simplified farm_meet_goldie_menu_445588cd:

    # goldie "Men and animals lose their minds around here. Most people have run off to take their chances elsewhere, like my little brother just did. Perhaps I should run too..."
    goldie "人和动物在这一带都会发疯。大多数人都逃走了,去别的地方碰碰运气,我弟弟也是。也许我也应该逃走..."

# game/BKstory_events.rpy:3358
translate chinese_simplified farm_meet_goldie_menu_38c83377:

    # you "But who lives there? Who built it?"
    you "但是那里住着谁呢?是谁建造的?"

# game/BKstory_events.rpy:3360
translate chinese_simplified farm_meet_goldie_menu_bb7c891a:

    # goldie "It's been standing for as long as anyone could remember, really. There were always stories, though..."
    goldie "对于这栋房子来说,它已经矗立了很久了,比任何人都要记忆深刻。不过,总有一些流传的故事..."

# game/BKstory_events.rpy:3362
translate chinese_simplified farm_meet_goldie_menu_d420d8cd:

    # goldie "The old folks didn't like this area. Forbade us kids to go near it."
    goldie "老人们都不太喜欢这个地方。他们禁止我们小孩子靠近它。"

# game/BKstory_events.rpy:3364
translate chinese_simplified farm_meet_goldie_menu_85b1d5ea:

    # goldie "As for who or what lives there, your guess is as good as mine."
    goldie "至于到底是谁或是什么住在那里,我也只能和你猜个半天了。"

# game/BKstory_events.rpy:3366
translate chinese_simplified farm_meet_goldie_menu_3c7ec6d4:

    # you "Hmm."
    you "嗯。"

# game/BKstory_events.rpy:3370
translate chinese_simplified farm_meet_goldie_menu_c9201340:

    # you "What if I helped you lift this curse?"
    you "如果我能帮你解开这个诅咒,那会怎么样呢?"

# game/BKstory_events.rpy:3372
translate chinese_simplified farm_meet_goldie_menu_f886c885:

    # goldie "Well... Many have tried before."
    goldie "嗯...以前很多人都尝试过了。"

# game/BKstory_events.rpy:3374
translate chinese_simplified farm_meet_goldie_menu_c160e0bb:

    # goldie "Months ago, I advertised that I would give the farm and its surrounding area to anyone who could lift the curse."
    goldie "几个月前,我发布消息说,只要有人成功解开诅咒,我就把这片农场连同周围的区域都送给他。"

# game/BKstory_events.rpy:3376
translate chinese_simplified farm_meet_goldie_menu_c029ce59:

    # goldie "For a time, that brought all sorts of adventurers here, who wanted to try their luck. For a time..."
    goldie "这招确实吸引了各路冒险者前来一试身手。但是..."

# game/BKstory_events.rpy:3378
translate chinese_simplified farm_meet_goldie_menu_1adf4f67:

    # goldie "But I've run out of adventurers. And the curse still stands."
    goldie "不过现在,所有的冒险者都已经消失无踪了,诅咒依旧存在。"

# game/BKstory_events.rpy:3381
translate chinese_simplified farm_meet_goldie_menu_706fd3f6:

    # you "I will give it a try. I don't need a reward. I've got a weak spot for damsels in distress."
    you "我会试一试的。我不需要任何报酬。我对困境中的女士总是有点偏心。"

# game/BKstory_events.rpy:3383
translate chinese_simplified farm_meet_goldie_menu_533d79da:

    # goldie "Will you? Then, I will make you the same offer. It's only fair."
    goldie "你愿意吗?那么,我会给你同样的条件。这样才公平。"

# game/BKstory_events.rpy:3385
translate chinese_simplified farm_meet_goldie_menu_29305cf5:

    # you "Let's not get ahead of ourselves. First we have to solve your problem."
    you "让我们不要过于乐观。首先我们得解决你的问题。"

# game/BKstory_events.rpy:3388
translate chinese_simplified farm_meet_goldie_menu_bf105698:

    # you "Not true. You still have me... Would you cut me the same deal if I tried?"
    you "这可不对。你还有我啊...那如果我来试试,你会给我同样的条件吗?"

# game/BKstory_events.rpy:3390
translate chinese_simplified farm_meet_goldie_menu_ec474235:

    # goldie "You? Why, of course."
    goldie "你?当然了。"

# game/BKstory_events.rpy:3392
translate chinese_simplified farm_meet_goldie_menu_dea1e893:

    # goldie "Provided you manage to drive this curse away, which I doubt... Sorry."
    goldie "不过,前提是你能成功驱散这个诅咒,我可不太相信你做得到...抱歉。"

# game/BKstory_events.rpy:3394
translate chinese_simplified farm_meet_goldie_menu_2b43ba6c:

    # you "We won't know until we try."
    you "我们总得试试看。"

# game/BKstory_events.rpy:3397
translate chinese_simplified farm_meet_goldie_menu_fde0912b:

    # you "Risking one's hide and mind for a run-down piece of rubble isn't really worth it, in my opinion."
    you "我觉得为了一片破败不堪的房子而冒生命和精神上的危险,可不太值得。"

# game/BKstory_events.rpy:3399
translate chinese_simplified farm_meet_goldie_menu_36d8a3ee:

    # goldie "But... I have naught else to give..."
    goldie "可是...我已经别无所有了..."

# game/BKstory_events.rpy:3401
translate chinese_simplified farm_meet_goldie_menu_54e38408:

    # you "Hmm... We'll see about that."
    you "嗯...我们拭目以待吧。"

# game/BKstory_events.rpy:3403
translate chinese_simplified farm_meet_goldie_menu_83f50b7a:

    # "You take a long, appreciative look at her well-rounded shapes, making her squirm uncomfortably."
    "你仔细端详着她曲线优美的身材,让她不安地扭动起来。"

# game/BKstory_events.rpy:3405
translate chinese_simplified farm_meet_goldie_menu_36a1d9eb:

    # goldie "Anyway, how do you expect to solve the mystery of this place?"
    goldie "总之,你打算如何解开这里的谜团呢?"

# game/BKstory_events.rpy:3411
translate chinese_simplified farm_meet_goldie_menu_522667eb:

    # goldie "I hope you're right..."
    goldie "我希望你说得对..."

# game/BKstory_events.rpy:3413
translate chinese_simplified farm_meet_goldie_menu_c0c1e798:

    # goldie "I am Goldie, by the way."
    goldie "我叫戈尔迪。"

# game/BKstory_events.rpy:3415
translate chinese_simplified farm_meet_goldie_menu_6e601749:

    # you "I am [MC.name]."
    you "我叫[MC.name]。"

# game/BKstory_events.rpy:3419
translate chinese_simplified farm_meet_goldie_menu_fed8ee05:

    # goldie "[MC.name], the farm is this way. Please, stay safe."
    goldie "[MC.name],农场就在这个方向,请小心行事。"

# game/BKstory_events.rpy:3436
translate chinese_simplified farm_exorcism_attempt_cb30f5a6:

    # you "This place {i}{b}is{/b}{/i} creepy."
    you "这地方{i}{b}的确{/b}{/i}很阴森可怕。"

# game/BKstory_events.rpy:3438
translate chinese_simplified farm_exorcism_attempt_f08bf255:

    # "The farm's insides are full of dust and cobwebs. You expected as much."
    "农场内部到处都是灰尘和蜘蛛网,这也在意料之中。"

# game/BKstory_events.rpy:3440
translate chinese_simplified farm_exorcism_attempt_47e41a1b:

    # "Walking slowly through the rubble, you see the remnants of the farm's facilities: a large pig stall, stables and pens for the animals, an old toolshed..."
    "你慢慢地穿过一片瓦砾,看到农场设施的残骸:一个大猪圈,马厩和动物圈,还有一个旧工具棚..."

# game/BKstory_events.rpy:3442
translate chinese_simplified farm_exorcism_attempt_97145ea7:

    # you "Nothing out of the ordinary, I guess. Wait... What's this?"
    you "看起来没什么特别的。等等,这是什么?"

# game/BKstory_events.rpy:3446
translate chinese_simplified farm_exorcism_attempt_12605851:

    # "A large hole is gaping in the ground. You can't say that this was bored with any human tools."
    "地面上出现了一个大洞。你不认为是用任何人类工具挖掘出来的。"

# game/BKstory_events.rpy:3448
translate chinese_simplified farm_exorcism_attempt_bf443536:

    # you "It's like something... Bored through the earth and burst out here..."
    you "好像是某种东西....穿透地球而突然出现在这里。"

# game/BKstory_events.rpy:3450
translate chinese_simplified farm_exorcism_attempt_7baa3c47:

    # "You take a look into the dark hole, trying to shed some light on what's inside with your torch. A strong, musky stench is emanating from the hole."
    "你用手电筒照进黑洞内,想弄清那里面到底是什么。一股浓烈的霉味从洞里飘了出来。"

# game/BKstory_events.rpy:3452
translate chinese_simplified farm_exorcism_attempt_5e1f856d:

    # you "Weird..."
    you "真奇怪..."

# game/BKstory_events.rpy:3454
translate chinese_simplified farm_exorcism_attempt_b04c7435:

    # "The strange hole seems to lead to a lower cave... Inside, the walls seem to be bulging and oozing some king of sirupy liquid, although the flickering of your torch could be playing tricks on your imagination."
    "这个奇怪的洞似乎通往下面的洞穴...洞内的墙壁似乎在鼓胀,还在渗出某种糖浆般的液体,不过可能只是火光造成的错觉。"

# game/BKstory_events.rpy:3458
translate chinese_simplified farm_exorcism_attempt_3c55d295:

    # "???" "Muhahahaha"
    "？？？" "哈哈哈哈"

# game/BKstory_events.rpy:3462
translate chinese_simplified farm_exorcism_attempt_bfc851a3:

    # you "What... What was that?"
    you "什....那是什么东西！？"

# game/BKstory_events.rpy:3464
translate chinese_simplified farm_exorcism_attempt_02419f82:

    # "???" "Ah... At last... A visitor..."
    "？？？" "啊……终于……有访客了……"

# game/BKstory_events.rpy:3466
translate chinese_simplified farm_exorcism_attempt_30e32c48:

    # you "Sh... Show yourself!"
    you "嘘...现身吧!"

# game/BKstory_events.rpy:3472
translate chinese_simplified farm_exorcism_attempt_5624b186:

    # spirit "Booh."
    spirit "繁荣！"

# game/BKstory_events.rpy:3476
translate chinese_simplified farm_exorcism_attempt_816e6c51:

    # you "Aaah!" with vpunch
    you "啊！" with vpunch

# game/BKstory_events.rpy:3478
translate chinese_simplified farm_exorcism_attempt_014bb8de:

    # you "Who... What... Who the fuck are you?"
    you "你是谁?什么东西?"

# game/BKstory_events.rpy:3480
translate chinese_simplified farm_exorcism_attempt_7a861760:

    # spirit "I am Varnoshi the soul-eater..."
    spirit "我是噬魂者瓦诺希..."

# game/BKstory_events.rpy:3482
translate chinese_simplified farm_exorcism_attempt_968fb602:

    # spirit "I am the hungry catcher, escaped from the seventh hell, spawn of Wargagath..."
    spirit "我是从第七层地狱逃脱的饥饿捕食者,瓦尔加嘉斯的后裔..."

# game/BKstory_events.rpy:3486
translate chinese_simplified farm_exorcism_attempt_ab9221fd:

    # spirit "Careless stranger... Prepare to be my next meal!"
    spirit "大意的陌生人,准备成为我的下一顿了!"

# game/BKstory_events.rpy:3488
