    ramias "我很抱歉没有表达清楚..."

# game/BKstory_events.rpy:18926
translate chinese_simplified meet_ramias_0c159461:

    # ramias "I will buy the knife. I won't buy the rest."
    ramias "我会买那把刀。其他的就不买了。"

