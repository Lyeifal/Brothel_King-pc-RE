    # ramias "I see. So that's how you're going to play it, eh?"
    ramias "我明白了。看来你是这样打算的,是吗?"

# game/BKstory_events.rpy:18942
translate chinese_simplified meet_ramias_5df61d7e:

    # thug3 "Don't try to be a hero now... Hand over your cash..."
    thug3 "别装英雄了...把钱交出来..."

