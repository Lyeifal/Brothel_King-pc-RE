{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Perk",
  "description": "EN: Girl perk definition.\nZH: 女孩天赋定义。",
  "type": "object",
  "required": ["name", "type"],
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["skill", "passive", "active"]
    },
    "effects": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "target": { "type": "string" },
          "value": { "type": "number" },
          "scope": { "type": ["string", "null"] }
        }
      }
    },
    "archetype": {
      "type": ["string", "null"],
      "default": null
    },
    "pic": {
      "type": ["string", "null"],
      "default": null
    },
    "perk_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0
    },
    "min_rank": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "base_description": {
      "type": "string",
      "default": ""
    }
  }
}
